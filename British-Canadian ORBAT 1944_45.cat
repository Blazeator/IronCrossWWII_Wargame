  <sharedRules>
    <rule id="ff2e-86aa-5f98-3b02" name="Churchill Crocodile" hidden="false">
      <description>Puede usar bien su lanzallamas o bien un cañon de valor 8</description>
    </rule>
    <rule id="dba8-9de3-de12-6b44" name="1945 solo" hidden="false"/>
    <rule name="Petard" id="2dca-8c20-e454-6f45" hidden="false">
      <description>Alcance limitado a 12&quot; (30cm)
Convierten impactos exitosos en marcadores de moral a 2+, en lugar de 4+
Contra vehículos tienen bonificador de +1 en la tirada para penetrar blindaje.
Cuentan como unidad HEAVY e ignoran cobertura contra objetivos en edificios, búnkeres y trincheras</description>
    </rule>
  </sharedRules>
